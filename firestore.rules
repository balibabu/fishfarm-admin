rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
    }

    match /site/{docId} {
      allow read: if true
      allow write: if isAdmin()
    }

    match /fishes/{docId} {
      allow read: if true
      allow write: if isAdmin()
    }

    match /gallery/{docId} {
      allow read: if true
      allow write: if isAdmin()
    }

    match /videos/{docId} {
      allow read: if true
      allow write: if isAdmin()
    }
  }
}
